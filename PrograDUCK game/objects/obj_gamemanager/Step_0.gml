if (global.completion_percentage == 100) {
	global.gamecompleted = true;
	global.isnewplayer = false;
}
	
if(debug_mode){
	global.levels = [1,1,1,1,1];
	global.sublevels1 = [1,1,1];
	global.sublevels2 = [1,1,1];
	global.sublevels3 = [1,1,1];
	global.sublevels3 = [1,1,1];
	global.rainbowduck = true;
	global.gamecompleted = true;
}